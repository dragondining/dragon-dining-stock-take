# Supabase → Connect → Session pooler. Do not commit the real value.
SUPABASE_DB_URL=
# Supabase → Project Settings → API. The anon key is public, but this app keeps it on the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Project Settings → API → service_role. Never put this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
